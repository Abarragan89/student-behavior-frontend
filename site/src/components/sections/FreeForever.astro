---
// The promise: free forever, private, made for phones.
import { Heart, ShieldCheck, Smartphone } from 'lucide-react'
import { FeatureCards } from '../landing/LandingSections'
import type { Feature } from '../landing/LandingSections'

const promises: Array<Feature> = [
  {
    title: 'Free forever',
    text: 'No trial, no paid plan, no credit card and no ads. Everything here today stays free.',
    icon: Heart,
    chip: 'bg-primary text-primary-foreground',
  },
  {
    title: 'Private by design',
    text: 'Student names and lesson plans are encrypted. Student information is never sold, never used for ads, and never used to train AI.',
    icon: ShieldCheck,
    chip: 'bg-secondary text-foreground',
  },
  {
    title: 'Made for your phone',
    text: 'Big buttons for the middle of a lesson. It works in any browser, and the installed app keeps working when the Wi-Fi drops.',
    icon: Smartphone,
    chip: 'bg-accent text-accent-foreground',
  },
]
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      Free forever.{' '}
      <span class="box-decoration-clone rounded-md bg-accent px-2 text-accent-foreground"
        >Not a free trial.</span
      >
    </h2>
    <p class="mt-4 text-lg text-muted-foreground">
      TeachForFree is made by one developer, for teachers. Classroom tools
      shouldn’t come out of your paycheck.
    </p>
  </div>
  <div class="mt-10">
    <FeatureCards items={promises} className="md:grid-cols-3" />
  </div>
</section>
