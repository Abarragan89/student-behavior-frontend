---
// A link styled as the app's shadcn button. Links stay <a> (not <button>) so
// screen readers announce them as links.
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'

interface Props {
  href: string
  variant?: 'default' | 'outline'
  rel?: string
  class?: string
}
const { href, variant = 'default', rel, class: className } = Astro.props
---

<a
  href={href}
  rel={rel}
  class={cn(
    buttonVariants({ variant }),
    'h-12 rounded-lg border-2 border-border px-6 text-base font-bold shadow-md',
    // shadcn's outline variant has no text color, so it would inherit
    // white text inside the violet closing band.
    variant === 'outline' && 'bg-card text-card-foreground',
    className,
  )}
>
  <slot />
</a>
