---
// Links to the other feature pages and the FAQ, at the end of a page.
import { ArrowRight } from 'lucide-react'
import { FAQ_PAGE, FEATURE_PAGES } from '../nav'

interface Props {
  /** This page, left out of the list. */
  current: string
}
const { current } = Astro.props
const pages = [...FEATURE_PAGES, FAQ_PAGE].filter((p) => p.href !== current)
---

<nav aria-label="More from TeachForFree" class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:pb-20">
  <h2 class="text-2xl font-bold tracking-tight">More from TeachForFree</h2>
  <ul class="mt-6 grid gap-4 md:grid-cols-3">
    {
      pages.map((page) => (
        <li class="flex">
          <a
            href={page.href}
            class="group flex w-full flex-col gap-2 rounded-lg border-2 border-border bg-card p-5 text-card-foreground shadow-md transition-transform hover:-translate-y-0.5 motion-reduce:transition-none"
          >
            <span class="flex items-center gap-1.5 text-lg font-bold">
              {page.label}
              <ArrowRight className="size-4" aria-hidden />
            </span>
            <span class="text-muted-foreground">{page.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
