---
import { ArrowDown } from 'lucide-react'
import ButtonLink from '../ButtonLink.astro'
import InstallApp from '../islands/InstallApp'
import { Eyebrow } from './LandingSections'
import { StudentGridDemo } from './StudentGridDemo'
import { loginUrl } from '../../site'
---

<section
  class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-20"
>
  <div>
    <Eyebrow label="Free for teachers" className="bg-secondary text-foreground" />
    <h1
      class="mt-5 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
    >
      Track behavior. Teach from your notes. All from{' '}
      <span
        class="box-decoration-clone rounded-md bg-accent px-2 text-accent-foreground"
        >your phone.</span
      >
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted-foreground">
      Two simple tools: tap a student to give a positive or negative mark, and
      keep short lesson outlines you can glance at while you teach.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <ButtonLink href={loginUrl} rel="nofollow">
        Sign in with Google — it's free
      </ButtonLink>
      <InstallApp client:only="react" placement="hero">
        <!-- Holds the button's place on phones until it appears. -->
        <div slot="fallback" class="h-12 sm:hidden" aria-hidden="true"></div>
      </InstallApp>
      <ButtonLink href="#how-it-works" variant="outline">
        See how it works
        <ArrowDown className="size-5" />
      </ButtonLink>
    </div>
  </div>

  <div>
    <p
      class="mb-4 flex items-center justify-center gap-1 font-mono text-sm font-bold"
    >
      Try it: tap a student
      <ArrowDown className="size-4" />
    </p>
    <!-- Drawn with the page; becomes tappable when scrolled into view. -->
    <StudentGridDemo client:visible />
  </div>
</section>
