---
// Something the app prints (a report, a lesson plan, a conference notice),
// shown as a sheet of paper. The screenshots come from scripts/capture.
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  image: ImageMetadata
  alt: string
  /** Degrees; a slight tilt reads as a real sheet. */
  tilt?: number
  /** Show only the top of the page, fading out (e.g. "26rem"). */
  crop?: string
  class?: string
}
const { image, alt, tilt = 0, crop, class: className } = Astro.props
---

<div
  class:list={['paper', className]}
  style={`--tilt: ${tilt}deg;${crop ? ` --crop: ${crop};` : ''}`}
  data-crop={crop ? '' : undefined}
>
  <div class="paper-sheet">
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[360, 725, 1450]}
      sizes="(min-width: 1024px) 560px, 92vw"
      loading="lazy"
      class="block h-auto w-full"
    />
  </div>
</div>

<style>
  .paper {
    transform: rotate(var(--tilt));
  }
  .paper-sheet {
    overflow: hidden;
    padding: 6% 6.5% 7%;
    border: 2px solid var(--border);
    border-radius: 6px;
    /* Paper stays white in dark mode, like the real thing. */
    background: #fff;
    box-shadow: var(--shadow-hard);
  }
  .paper[data-crop] .paper-sheet {
    max-height: var(--crop);
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
    /* The border fades with it, so the sheet looks like it runs on. */
  }
  @media (prefers-reduced-motion: no-preference) {
    .paper {
      transition: transform 300ms ease;
    }
  }
</style>
