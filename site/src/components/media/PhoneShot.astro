---
// A screenshot of the app (scripts/capture) in a phone.
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import PhoneFrame from './PhoneFrame.astro'

interface Props {
  image: ImageMetadata
  alt: string
  size?: 'hero' | 'md' | 'sm'
  /** Load with the page (only for a picture in the first screen). */
  priority?: boolean
  class?: string
}
const { image, alt, size = 'md', priority = false, class: className } = Astro.props
---

<PhoneFrame size={size} class={className}>
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[300, 600]}
    sizes="(min-width: 1024px) 300px, 80vw"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="h-full w-full object-cover"
  />
</PhoneFrame>
