---
// A phone drawn in CSS around a recording or screenshot of the app: bezel,
// side buttons, Dynamic Island, status bar and home indicator. The screen
// below the status bar is 393×793, the size the captures are recorded at
// (scripts/capture).
//
// Everything is sized in container units, so the phone scales as one piece.
interface Props {
  /**
   * hero: as big as fits under the header (up to 320px wide), so it's
   * fully on screen above the fold. md: up to 300px. sm: up to 250px.
   */
  size?: 'hero' | 'md' | 'sm'
  /** The status bar clock; the captures are recorded at 10:15. */
  time?: string
  class?: string
}
const { size = 'md', time = '10:15', class: className } = Astro.props
---

<div class:list={['phone', `phone-${size}`, className]}>
  <div class="phone-body">
    <span class="phone-key phone-key-action" aria-hidden="true"></span>
    <span class="phone-key phone-key-up" aria-hidden="true"></span>
    <span class="phone-key phone-key-down" aria-hidden="true"></span>
    <span class="phone-key phone-key-power" aria-hidden="true"></span>
    <div class="phone-screen">
      <div class="phone-status" aria-hidden="true">
        <span class="phone-time">{time}</span>
        <span class="phone-island"></span>
        <span class="phone-icons">
          <svg viewBox="0 0 18 12" class="phone-icon"
            ><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect
              x="5"
              y="5.5"
              width="3"
              height="6.5"
              rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"
            ></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg
          >
          <svg viewBox="0 0 16 12" class="phone-icon"
            ><path
              d="M8 2.2c2.4 0 4.6.9 6.3 2.5l1.2-1.3A10.7 10.7 0 0 0 8 .4C5.2.4 2.5 1.5.5 3.4l1.2 1.3A9 9 0 0 1 8 2.2Zm0 3.6c1.4 0 2.7.5 3.7 1.4l1.2-1.3A7.1 7.1 0 0 0 8 4a7.1 7.1 0 0 0-4.9 1.9l1.2 1.3A5.3 5.3 0 0 1 8 5.8Zm0 3.5c.5 0 .9.2 1.2.5L8 11.6 6.8 9.8c.3-.3.7-.5 1.2-.5Z"
            ></path></svg
          >
          <svg viewBox="0 0 27 12" class="phone-icon phone-battery"
            ><rect
              x="0.5"
              y="0.5"
              width="23"
              height="11"
              rx="3.2"
              fill="none"
              stroke="currentColor"
              stroke-opacity=".4"></rect><rect
              x="2"
              y="2"
              width="17"
              height="8"
              rx="2"></rect><path
              d="M25 4v4a2 2 0 0 0 0-4Z"
              fill-opacity=".4"></path></svg
          >
        </span>
      </div>
      <div class="phone-content">
        <slot />
      </div>
      <span class="phone-home" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .phone {
    container-type: inline-size;
    width: min(100%, var(--phone-max));
    margin-inline: auto;
    --phone-max: 300px;
  }
  .phone-sm {
    --phone-max: 250px;
  }
  .phone-hero {
    /* Fits under the sticky header with room for the steps below it:
       0.478 is the phone's width ÷ height. */
    --phone-max: min(320px, calc((100svh - 11.5rem) * 0.478));
  }
  @media (max-width: 1023px) {
    .phone-hero {
      --phone-max: 290px;
    }
  }

  .phone-body {
    position: relative;
    padding: 3.2cqi;
    border-radius: 15.5cqi;
    background: #18181b;
    /* A thin metal rim, then the brand's hard offset shadow. */
    box-shadow:
      0 0 0 0.6cqi #3f3f46,
      0 0 0 1.2cqi #0a0a0a,
      var(--shadow-hard);
  }
  .phone-key {
    position: absolute;
    width: 1.2cqi;
    border-radius: 1cqi;
    background: #27272a;
    box-shadow: inset 0 0 0 0.3cqi #3f3f46;
  }
  .phone-key-action {
    left: -2cqi;
    top: 20%;
    height: 7cqi;
  }
  .phone-key-up {
    left: -2cqi;
    top: 28%;
    height: 13cqi;
  }
  .phone-key-down {
    left: -2cqi;
    top: 36%;
    height: 13cqi;
  }
  .phone-key-power {
    right: -2cqi;
    top: 30%;
    height: 20cqi;
  }

  .phone-screen {
    position: relative;
    overflow: hidden;
    border-radius: 12.4cqi;
    background: #f7f9f3;
    /* Keeps the rounded corners crisp over a playing video in Safari. */
    isolation: isolate;
  }
  .phone-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    aspect-ratio: 393 / 59;
    padding: 2.6cqi 7cqi 0 9cqi;
    color: #0a0a0a;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 4cqi;
    background: #f7f9f3;
  }
  .phone-time {
    width: 18cqi;
    letter-spacing: -0.01em;
  }
  .phone-island {
    width: 30cqi;
    height: 8.6cqi;
    border-radius: 99px;
    background: #0a0a0a;
  }
  .phone-icons {
    display: flex;
    gap: 1.4cqi;
    align-items: center;
    justify-content: flex-end;
    width: 18cqi;
  }
  .phone-icon {
    height: 3cqi;
    width: auto;
    fill: currentColor;
  }
  .phone-battery {
    height: 3.2cqi;
  }
  .phone-content {
    aspect-ratio: 393 / 793;
  }
  .phone-content > :global(*) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phone-home {
    position: absolute;
    left: 50%;
    bottom: 2.2cqi;
    width: 34cqi;
    height: 1.3cqi;
    border-radius: 99px;
    background: #0a0a0a;
    transform: translateX(-50%);
    opacity: 0.85;
  }
</style>
