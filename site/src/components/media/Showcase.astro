---
// A feature section: label, heading and a few lines on one side, a phone or
// a printed page (the "visual" slot) on the other.
import { Eyebrow } from '../landing/LandingSections'

interface Props {
  eyebrow: string
  /** Colors for the label, e.g. "bg-accent text-accent-foreground". */
  eyebrowClass?: string
  /** Marks a feature that just came out. */
  isNew?: boolean
  title: string
  lead: string
  /** A grey band with lines above and below. */
  muted?: boolean
  /** Visual on the left on wide screens. */
  reverse?: boolean
  id?: string
  /** The heading level: h2 normally. */
  level?: 'h2' | 'h3'
}
const {
  eyebrow,
  eyebrowClass,
  isNew = false,
  title,
  lead,
  muted = false,
  reverse = false,
  id,
  level = 'h2',
} = Astro.props
const Heading = level
---

<section
  id={id}
  data-band={muted ? '' : undefined}
  class:list={[
    'scroll-mt-16 overflow-x-clip',
    muted && 'border-y-2 border-border bg-muted',
  ]}
>
  <div
    class:list={[
      'mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 lg:gap-14 lg:py-24',
      // The picture gets the wider column.
      reverse
        ? 'lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]'
        : 'lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]',
    ]}
  >
    <div class:list={[reverse && 'lg:order-2']}>
      <div class="flex flex-wrap items-center gap-2">
        <Eyebrow label={eyebrow} className={eyebrowClass} />
        {
          isNew && (
            <span class="rounded-full border-2 border-border bg-card px-2.5 py-0.5 text-xs font-bold">
              New
            </span>
          )
        }
      </div>
      <Heading
        class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl"
      >
        {title}
      </Heading>
      <p class="mt-4 max-w-xl text-lg text-muted-foreground">{lead}</p>
      <slot />
    </div>
    <div class:list={['min-w-0', reverse && 'lg:order-1']}>
      <slot name="visual" />
    </div>
  </div>
</section>
