---
import { iconUrl, logoUrl } from 'virtual:tff-head'
import BaseLayout from '../layouts/BaseLayout.astro'
import SignedInRedirect from '../components/SignedInRedirect.astro'
import Hero from '../components/landing/Hero.astro'
import ClosingBand from '../components/landing/ClosingBand.astro'
import {
  BehaviorSection,
  Highlights,
  LessonNotesSection,
} from '../components/landing/LandingSections'
import { SITE_NAME } from '../site'

const title = 'TeachForFree — Free behavior tracking & lesson notes for teachers'
const description =
  'Free classroom tools for teachers: tap a student to give a positive or negative behavior mark, and keep short lesson notes on your phone while you teach.'

// What search engines read about the site (schema.org). No ratings: Google
// only accepts real reviews.
const site = Astro.site!
const url = site.href
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${url}#organization`,
      name: SITE_NAME,
      url,
      logo: new URL(iconUrl, site).href,
    },
    {
      '@type': 'WebSite',
      '@id': `${url}#website`,
      name: SITE_NAME,
      url,
      publisher: { '@id': `${url}#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: SITE_NAME,
      url,
      description,
      image: new URL(logoUrl, site).href,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web, iOS, Android',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': `${url}#organization` },
    },
  ],
}
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <SignedInRedirect slot="head" />
  <Hero />
  <BehaviorSection />
  <LessonNotesSection />
  <Highlights />
  <ClosingBand />
</BaseLayout>
