---
import { iconUrl, logoUrl } from 'virtual:tff-head'
import BaseLayout from '../layouts/BaseLayout.astro'
import SignedInRedirect from '../components/SignedInRedirect.astro'
import Hero from '../components/landing/Hero.astro'
import ClosingBand from '../components/landing/ClosingBand.astro'
import Section from '../components/Section.astro'
import FaqList from '../components/FaqList.astro'
import BehaviorReports from '../components/sections/BehaviorReports.astro'
import SubPlans from '../components/sections/SubPlans.astro'
import Conferences from '../components/sections/Conferences.astro'
import FreeForever from '../components/sections/FreeForever.astro'
import PosterPreload from '../components/media/PosterPreload.astro'
import { MoreLink } from '../components/landing/LandingSections'
import { CLIPS } from '../captures'
import { faqItems } from '../content/faq'
import { SITE_NAME } from '../site'

const title = 'Free Lesson Planner & Behavior Tracker | TeachForFree'
const description =
  'Teach from your lesson plan and track behavior on your phone. Behavior reports made for you, sub plans with a QR code, and conference sign-ups. Free for teachers.'

// What search engines read about the site (schema.org). No ratings: Google
// only accepts real reviews.
const site = Astro.site!
const url = site.href
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${url}#organization`,
      name: SITE_NAME,
      url,
      logo: new URL(iconUrl, site).href,
    },
    {
      '@type': 'WebSite',
      '@id': `${url}#website`,
      name: SITE_NAME,
      url,
      publisher: { '@id': `${url}#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: SITE_NAME,
      url,
      description,
      image: new URL(logoUrl, site).href,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web, iOS, Android',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': `${url}#organization` },
    },
  ],
}
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <SignedInRedirect slot="head" />
  <PosterPreload slot="head" clip={CLIPS.planAndMarks} />
  <Hero />
  <BehaviorReports id="how-it-works" muted />
  <SubPlans />
  <Conferences muted />
  <FreeForever />
  <Section title="Questions teachers ask" muted>
    <div class="max-w-3xl">
      <FaqList
        items={faqItems([
          'is-it-free',
          'conference-families',
          'offline',
          'student-data',
        ])}
      />
      <MoreLink href="/faq" label="All questions" />
    </div>
  </Section>
  <ClosingBand />
</BaseLayout>
