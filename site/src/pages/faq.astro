---
import BaseLayout from '../layouts/BaseLayout.astro'
import FaqList from '../components/FaqList.astro'
import RelatedPages from '../components/RelatedPages.astro'
import ClosingBand from '../components/landing/ClosingBand.astro'
import { ALL_FAQ, FAQ_GROUPS, faqJsonLd } from '../content/faq'
import { CONTACT_EMAIL } from '../site'

const description =
  'Answers about TeachForFree: what it costs, Google Classroom, behavior marks, lesson plans, substitutes, offline use, and student privacy.'

const groups = FAQ_GROUPS.map((group) => ({
  ...group,
  slug: group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
}))
---

<BaseLayout
  title="Frequently Asked Questions | TeachForFree"
  description={description}
  path="/faq"
  jsonLd={faqJsonLd(ALL_FAQ)}
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:py-16">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Frequently asked questions
    </h1>
    <p class="mt-4 text-lg text-muted-foreground">
      Can’t find your answer? Email{' '}
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="font-bold text-primary underline underline-offset-4 dark:text-foreground"
        >{CONTACT_EMAIL}</a
      >.
    </p>

    <nav aria-label="Topics" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {
          groups.map((group) => (
            <li>
              <a
                href={`#${group.slug}`}
                class="inline-flex h-10 items-center rounded-lg border-2 border-border bg-card px-3 text-sm font-bold text-card-foreground"
              >
                {group.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((group) => (
        <section id={group.slug} class="mt-12 scroll-mt-20">
          <h2 class="mb-4 text-2xl font-bold tracking-tight">{group.title}</h2>
          <FaqList items={group.items} />
        </section>
      ))
    }
  </div>

  <RelatedPages current="/faq" />
  <ClosingBand />
</BaseLayout>
